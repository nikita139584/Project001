@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@* Лендинг Recipe.Site. Стили: wwwroot/css/index.css *@
@{
    Layout = null;
    ViewData["Title"] = "Recipe.Site";

    // Адреса медиа на внешнем сервере. w — ширина с запасом под retina.
    string Img(string name, int w) =>
        $"https://www.recipe.site/_next/image?url=https%3A%2F%2Fimg.recipe.site%2F{name}.webp%3Foptimizer%3Dimage&w={w}&q=75";
    string Vid(string name) => $"https://file.recipe.site/{name}.mp4";

    // Тип карточки в карусели -> (css-класс, ширина запрашиваемой картинки)
    (string css, int w) Kind(char k) => k switch
    {
        'v' => ("video-card", 0),
        'l' => ("little-img", 640),
        'n' => ("normal-img", 750),
        _ => ("big-img", 1920)
    };

    // Одна секция-карусель с примером сайта.
    // items: v = видео, l = узкое фото, n = среднее, b = широкое.
    void Showcase(string title, string url, string[] tags, (char kind, string file)[] items)
    {
        <section class="wrap block showcase">
            <div class="sc-head">
                <h2>
                    @if (url != null)
                    {
                        <a href="@url" target="_blank" rel="noopener noreferrer">@title</a>
                    }
                    else
                    {
                        @title
                    }
                </h2>
                @foreach (var t in tags)
                {
                    <span class="tag">@t</span>
                }
                <div class="sc-arrows">
                    <button class="arrow" type="button" data-dir="prev" aria-label="@Localizer["Previous"]" disabled>
                        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3.5 5.5 9l5.5 5.5" /></svg>
                    </button>
                    <button class="arrow" type="button" data-dir="next" aria-label="@Localizer["Next"]">
                        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5 12.5 9 7 14.5" /></svg>
                    </button>
                </div>
            </div>

            <div class="carousel">
                @for (var i = 0; i < items.Length; i++)
                {
                    var (css, w) = Kind(items[i].kind);
                    if (items[i].kind == 'v')
                    {
                        <video class="@css" controls muted playsinline preload="metadata">
                            <source src="@Vid(items[i].file)" type="video/mp4">
                        </video>
                    }
                    else
                    {
                        <img class="@css" src="@Img(items[i].file, w)" alt="@title — @(i + 1)" loading="lazy" decoding="async" />
                    }
                }
            </div>
        </section>
    }
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Сайти з рецептами, розсилки та цифрові @Localizer["Cookbooks"] для авторів." />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
</head>
<body>

    @* ===== Шапка ===== *@
    <header class="site-header">
        <div class="wrap">
            <a class="logo" href="~/">
                <span class="logo-mark" aria-hidden="true"><i></i></span>
                Recipe.Site
            </a>
            <nav class="nav" aria-label="Головна">
                <a href="/Blogs">@Localizer["Blog"]</a>
                <a href="/Recipes">@Localizer["Recipes"]</a>

                <a href="/Preferences">@Localizer["Preferences"]</a>

                @* Эта страница идёт мимо _Layout (Layout = null),
                   поэтому приветствие приходится повторять здесь. *@
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <span class="user-greeting">Привет, @User.Identity.Name!</span>
                    <form asp-controller="Account" asp-action="Logout"
                          method="post" class="logout-form">
                        <button type="submit" class="logout-button">Выйти</button>
                    </form>
                }
                else
                {
                    <a href="/Form">@Localizer["Register"]</a>
                    <a href="/Account/Login">Вход</a>
                }


   

            </nav>
        </div>
    </header>

    <main>

        @* ===== Головний екран ===== *@
        <section class="wrap hero">
            <img class="hero-img" src="https://www.recipe.site/_next/image?url=https%3A%2F%2Fimg.recipe.site%2Fhomepage-hero-image-cooking%2520copy.webp%3Foptimizer%3Dimage&w=1200&q=75" alt="@Localizer["HeroImageAlt"]" />

            <div class="hero-copy">
                <h1>
                    @Localizer["HeroLine1"]<br class="br-lg" />
                    @Localizer["HeroLine2"]<br class="br-lg" />
                    @Localizer["Cookbooks"]
                </h1>

                <div class="features">
                    <ul>
                        <li>@Localizer["FeatureRecipeEditor"]</li>
                        <li>@Localizer["FeatureNewsletters"]</li>
                        <li>@Localizer["FeaturePaidAccess"]</li>
                        <li>@Localizer["FeatureDomainDesign"]</li>
                        <li>@Localizer["FeatureSeoHosting"]</li>
                    </ul>
                    <ul>
                        <li>@Localizer["FeatureUnits"]</li>
                        <li>@Localizer["FeatureScaling"]</li>
                        <li>@Localizer["FeatureTimers"]</li>
                        <li>@Localizer["FeatureComments"]</li>
                        <li>@Localizer["FeatureVideo"]</li>
                    </ul>
                </div>
            </div>
        </section>

        @* ===== Приклади сайтів (дані — у масивах, розмітка — у Showcase) ===== *@
        @{
            Showcase(null, null, new[] { Localizer["TagWebsite"].Value, Localizer["TagNewsletter"].Value, Localizer["TagSubscriptions"].Value }, new[]
            {
    ('v', "marketing_homepage_hwoo_01"),
    ('l', "marketing_homepage_hwoo_02"),
    ('b', "marketing_homepage_hwoo_03"),
    ('l', "marketing_homepage_hwoo_04"),
    ('l', "marketing_homepage_hwoo_05"),
    ('l', "marketing_homepage_hwoo_06")
});

            Showcase("Katie Parla, Rome", null, new[] { Localizer["TagDigitalCookbook"].Value }, new[]
            {
                ('v', "marketing_homepage_rome_01"), ('l', "marketing_homepage_rome_02"),
                ('b', "marketing_homepage_rome_03"), ('n', "marketing_homepage_rome_04"),
                ('b', "marketing_homepage_rome_05"), ('l', "marketing_homepage_rome_06"),
                ('b', "marketing_homepage_rome_07")
            });

            Showcase("Cheffin' with Zach", null, new[] { Localizer["TagWebsite"].Value }, new[]
            {
                ('v', "cheffinwithzach"), ('b', "marketing_homepage_cheffinwithzach_01"),
                ('l', "marketing_homepage_cheffinwithzach_02"), ('l', "marketing_homepage_cheffinwithzach_03"),
                ('b', "marketing_homepage_cheffinwithzach_04"), ('l', "marketing_homepage_cheffinwithzach_05"),
                ('l', "marketing_homepage_cheffinwithzach_06")
            });
        }

        @* ===== Про продукт + демо-відео ===== *@
        <section class="wrap block intro">
            <div class="two-col">
                <div>
                    <p class="lead">
                        @Localizer["IntroLead1"]
                        @Localizer["IntroLead2"]
                        @Localizer["IntroLead3"]
                    </p>
                    <video class="intro-video" controls muted playsinline preload="metadata">
                        <source src="@Vid("marketing_homepage_recipe_editor")" type="video/mp4">
                    </video>
                </div>

                <div class="aside">
                    <p>@Localizer["IntroAside1"]</p>
                    <p>@Localizer["IntroAside2"]</p>
                </div>
            </div>
        </section>

        @{
            Showcase("Krizkitch", "https://www.krizkitch.com/", new[] { Localizer["TagWebsite"].Value, Localizer["TagNewsletter"].Value, Localizer["TagSubscriptions"].Value }, new[]
            {
                ('v', "marketing_homepage_krizkitch_01"), ('l', "marketing_homepage_krizkitch_02"),
                ('b', "marketing_homepage_krizkitch_03"), ('l', "marketing_homepage_krizkitch_04"),
                ('b', "marketing_homepage_krizkitch_05")
            });

            Showcase("Mixtures, Community cookbook", "https://mixtures.recipe.site/", new[] { Localizer["TagDigitalCookbook"].Value }, new[]
            {
                ('b', "marketing_homepage_mixtures_01"), ('l', "marketing_homepage_mixtures_02"),
                ('b', "marketing_homepage_mixtures_03"), ('l', "marketing_homepage_mixtures_04"),
                ('b', "marketing_homepage_mixtures_05")
            });
        }

        @* ===== Тарифи ===== *@
        <section class="wrap block plans" id="plans">
            <h2>@Localizer["Plans"]</h2>

            <div class="plan-grid">
                <div class="plan">
                    <h3>@Localizer["PersonalPlan"]</h3>
                    <p class="price">$4/місяць</p>
                    <ul>
                        <li>@Localizer["UnlimitedRecipes"]</li>
                    </ul>
                    <p class="desc">@Localizer["PersonalDescription"]</p>
                    <a class="example desc" href="#">@Localizer["Example"]</a>
                    <div><a class="btn btn-black" href="#">@Localizer["TryFree"]</a></div>
                </div>

                <div class="plan">
                    <h3>@Localizer["CreatorPlan"]</h3>
                    <p class="price">$32/місяць*</p>
                    <ul>
                        <li>@Localizer["PaidAccessSubscriptions"]</li>
                        <li>@Localizer["Newsletters"]</li>
                        <li>@Localizer["FontsColorsLogo"]</li>
                        <li>@Localizer["CommentsRatings"]</li>
                        <li>@Localizer["AdsVideo"]</li>
                        <li>@Localizer["CustomDomain"]</li>
                    </ul>
                    <a class="example desc" href="#">@Localizer["Example"]</a>
                    <div><a class="btn btn-black" href="#">@Localizer["ChoosePlan"]</a></div>
                </div>

                <div class="plan">
                    <h3>@Localizer["ProfessionalPlan"]</h3>
                    <p class="price">$250–500/місяць*</p>
                    <ul>
                        <li>@Localizer["CustomDesignPages"]</li>
                        <li>@Localizer["CustomFeatures"]</li>
                        <li>@Localizer["PersonalSupport"]</li>
                    </ul>
                    <a class="example desc" href="#">@Localizer["Example"]</a>
                    <div><a class="btn btn-black" href="#">@Localizer["ContactUs"]</a></div>
                </div>
            </div>

            <p class="note">@Localizer["PlanNote"]</p>
        </section>

        @{
            Showcase("Ryan Nordheimer", "https://www.ryannordheimer.com/", new[] { Localizer["TagWebsite"].Value, Localizer["TagAds"].Value, Localizer["TagSubscriptions"].Value }, new[]
            {
                ('l', "marketing_homepage_ryannordheimer_01"), ('b', "marketing_homepage_ryannordheimer_02"),
                ('l', "marketing_homepage_ryannordheimer_03"), ('l', "marketing_homepage_ryannordheimer_04")
            });
        }

        @* ===== Чим відрізняємось ===== *@
        <section class="wrap block diff" id="about">
            <div class="two-col">
                <div>
                    <p class="lead">
                        @Localizer["DifferenceLead1"]
                        @Localizer["DifferenceLead2"]
                    </p>
                </div>

                <div class="aside">
                    <p>
                        @Localizer["DifferenceAside1"] @Localizer["DifferenceAside2"]
                    </p>
                    <p>
                        @Localizer["DifferenceAside3"] @Localizer["DifferenceAside4"]
                    </p>
                    <p><a href="#">@Localizer["ReadBlog"]</a></p>
                </div>
            </div>
        </section>

        @* ===== Підписка на новини ===== *@
        <section class="wrap block updates">
            <h2>@Localizer["ProjectUpdates"]</h2>
            <p>@Localizer["UpdatesDescription"]</p>
            <form class="subscribe" action="#" method="post">
                <input type="email" name="email" placeholder="@Localizer["YourEmail"]" aria-label="@Localizer["EmailAddress"]" required />
                <button type="submit">@Localizer["Subscribe"]</button>
            </form>
        </section>
    </main>

    @* ===== Футер ===== *@
    <footer class="site-footer">
        <div class="wrap">
            <div>
                <p><a href="~/">Recipe.Site</a> — @Localizer["FooterDescription"]</p>
                <p class="fine">Відгуки: alex@@recipe.site</p>
                <p>© 2026 Recipe.Site</p>
            </div>
            <nav class="footer-links" aria-label="Підвал сайту">
                <a href="#">@Localizer["GetStarted"]</a>
                <a href="#plans">@Localizer["Plans"]</a>
                <a href="#about">@Localizer["AboutUs"]</a>
                <a href="/Blogs">@Localizer["Blog"]</a>
                <a href="#">@Localizer["Terms"]</a>
            </nav>
        </div>
    </footer>

    @* Стрілки каруселей: прокрутка на пів ширини, блокування на краях *@
    <script>
            (function () {
                document.querySelectorAll('.showcase').forEach(function (section) {
                    var track = section.querySelector('.carousel');
                    var prev = section.querySelector('[data-dir="prev"]');
                    var next = section.querySelector('[data-dir="next"]');
                    if (!track || !prev || !next) return;

                    function update() {
                        var max = track.scrollWidth - track.clientWidth;
                        prev.disabled = track.scrollLeft <= 1;
                        next.disabled = track.scrollLeft >= max - 2;
                    }

                    function go(dir) {
                        track.scrollBy({ left: dir * track.clientWidth * 0.5, behavior: 'smooth' });
                    }

                    prev.addEventListener('click', function () { go(-1); });
                    next.addEventListener('click', function () { go(1); });
                    track.addEventListener('scroll', update, { passive: true });
                    window.addEventListener('resize', update);
                    update();
                });
            })();
    </script>
</body>
</html>
