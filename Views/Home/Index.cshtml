@* Лендинг Recipe.Site. Стили: wwwroot/css/index.css *@
@{
    Layout = null;
    ViewData["Title"] = "Recipe.Site";

    // Адреса медиа на внешнем сервере. w — ширина с запасом под retina.
    string Img(string name, int w) =>
        $"https://www.recipe.site/_next/image?url=https%3A%2F%2Fimg.recipe.site%2F{name}.webp%3Foptimizer%3Dimage&w={w}&q=75";
    string Vid(string name) => $"https://file.recipe.site/{name}.mp4";

    // Тип карточки в карусели -> (css-класс, ширина запрашиваемой картинки)
    (string css, int w) Kind(char k) => k switch
    {
        'v' => ("video-card", 0),
        'l' => ("little-img", 640),
        'n' => ("normal-img", 750),
        _ => ("big-img", 1920)
    };

    // Одна секция-карусель с примером сайта.
    // items: v = видео, l = узкое фото, n = среднее, b = широкое.
    void Showcase(string title, string url, string[] tags, (char kind, string file)[] items)
    {
        <section class="wrap block showcase">
            <div class="sc-head">
                <h2>
                    @if (url != null)
                    {
                        <a href="@url" target="_blank" rel="noopener noreferrer">@title</a>
                    }
                    else
                    {
                        @title
                    }
                </h2>
                @foreach (var t in tags)
                {
                    <span class="tag">@t</span>
                }
                <div class="sc-arrows">
                    <button class="arrow" type="button" data-dir="prev" aria-label="Назад" disabled>
                        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3.5 5.5 9l5.5 5.5" /></svg>
                    </button>
                    <button class="arrow" type="button" data-dir="next" aria-label="Вперед">
                        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5 12.5 9 7 14.5" /></svg>
                    </button>
                </div>
            </div>

            <div class="carousel">
                @for (var i = 0; i < items.Length; i++)
                {
                    var (css, w) = Kind(items[i].kind);
                    if (items[i].kind == 'v')
                    {
                        <video class="@css" controls muted playsinline preload="metadata">
                            <source src="@Vid(items[i].file)" type="video/mp4">
                        </video>
                    }
                    else
                    {
                        <img class="@css" src="@Img(items[i].file, w)" alt="@title — @(i + 1)" loading="lazy" decoding="async" />
                    }
                }
            </div>
        </section>
    }
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Сайти з рецептами, розсилки та цифрові кулінарні книги для авторів." />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
</head>
<body>

    @* ===== Шапка ===== *@
    <header class="site-header">
        <div class="wrap">
            <a class="logo" href="~/">
                <span class="logo-mark" aria-hidden="true"><i></i></span>
                Recipe.Site
            </a>
            <nav class="nav" aria-label="Головна">
                <a href="/Blogs">Блог</a>
                <a href="/Recipes">Рецепти</a>
                <a class="btn btn-blue" href="#">Зареєструватися</a>
            </nav>
        </div>
    </header>

    <main>

        @* ===== Головний екран ===== *@
        <section class="wrap hero">
            <img class="hero-img" src="https://www.recipe.site/_next/image?url=https%3A%2F%2Fimg.recipe.site%2Fhomepage-hero-image-cooking%2520copy.webp%3Foptimizer%3Dimage&w=1200&q=75" alt="Бабуся тре сир на кухні" />

            <div class="hero-copy">
                <h1>
                    Сайти з рецептами,<br class="br-lg" />
                    розсилки та цифрові<br class="br-lg" />
                    кулінарні книги
                </h1>

                <div class="features">
                    <ul>
                        <li>Редактор рецептів і CMS</li>
                        <li>Розсилки та підписки</li>
                        <li>Платний доступ</li>
                        <li>Власний домен і дизайн</li>
                        <li>SEO та хостинг</li>
                    </ul>
                    <ul>
                        <li>US → метрична система</li>
                        <li>Масштабування порцій</li>
                        <li>Таймери</li>
                        <li>Коментарі й оцінки</li>
                        <li>Відео</li>
                    </ul>
                </div>
            </div>
        </section>

        @* ===== Приклади сайтів (дані — у масивах, розмітка — у Showcase) ===== *@
        @{
            Showcase("h woo", null, new[] { "сайт", "розсилка", "підписки" }, new[]
            {
                ('v', "marketing_homepage_hwoo_01"), ('l', "marketing_homepage_hwoo_02"),
                ('b', "marketing_homepage_hwoo_03"), ('l', "marketing_homepage_hwoo_04"),
                ('l', "marketing_homepage_hwoo_05"), ('l', "marketing_homepage_hwoo_06")
            });

            Showcase("Katie Parla, Rome", null, new[] { "цифрова кулінарна книга" }, new[]
            {
                ('v', "marketing_homepage_rome_01"), ('l', "marketing_homepage_rome_02"),
                ('b', "marketing_homepage_rome_03"), ('n', "marketing_homepage_rome_04"),
                ('b', "marketing_homepage_rome_05"), ('l', "marketing_homepage_rome_06"),
                ('b', "marketing_homepage_rome_07")
            });

            Showcase("Cheffin' with Zach", null, new[] { "сайт" }, new[]
            {
                ('v', "cheffinwithzach"), ('b', "marketing_homepage_cheffinwithzach_01"),
                ('l', "marketing_homepage_cheffinwithzach_02"), ('l', "marketing_homepage_cheffinwithzach_03"),
                ('b', "marketing_homepage_cheffinwithzach_04"), ('l', "marketing_homepage_cheffinwithzach_05"),
                ('l', "marketing_homepage_cheffinwithzach_06")
            });
        }

        @* ===== Про продукт + демо-відео ===== *@
        <section class="wrap block intro">
            <div class="two-col">
                <div>
                    <p class="lead">
                        Recipe.Site — платформа для авторів кулінарного контенту: редактор рецептів,
                        підписки, розсилки та платний доступ в одному місці.
                        Це <em>Substack</em> і <em>New York Times Cooking</em> разом.
                    </p>
                    <video class="intro-video" controls muted playsinline preload="metadata">
                        <source src="@Vid("marketing_homepage_recipe_editor")" type="video/mp4">
                    </video>
                </div>

                <div class="aside">
                    <p>Для великих авторів робимо індивідуальні рішення та допомагаємо вести цифровий бізнес.</p>
                    <p>Вже є сайт? Додамо окремі функції, наприклад розширені сторінки рецептів, у ваш наявний сайт.</p>
                </div>
            </div>
        </section>

        @{
            Showcase("Krizkitch", "https://www.krizkitch.com/", new[] { "сайт", "розсилка", "підписки" }, new[]
            {
                ('v', "marketing_homepage_krizkitch_01"), ('l', "marketing_homepage_krizkitch_02"),
                ('b', "marketing_homepage_krizkitch_03"), ('l', "marketing_homepage_krizkitch_04"),
                ('b', "marketing_homepage_krizkitch_05")
            });

            Showcase("Mixtures, Community cookbook", "https://mixtures.recipe.site/", new[] { "цифрова кулінарна книга" }, new[]
            {
                ('b', "marketing_homepage_mixtures_01"), ('l', "marketing_homepage_mixtures_02"),
                ('b', "marketing_homepage_mixtures_03"), ('l', "marketing_homepage_mixtures_04"),
                ('b', "marketing_homepage_mixtures_05")
            });
        }

        @* ===== Тарифи ===== *@
        <section class="wrap block plans" id="plans">
            <h2>Тарифи</h2>

            <div class="plan-grid">
                <div class="plan">
                    <h3>Особистий</h3>
                    <p class="price">$4/місяць</p>
                    <ul>
                        <li>Необмежена кількість рецептів</li>
                    </ul>
                    <p class="desc">Для сімейних рецептів і особистих добірок.</p>
                    <a class="example desc" href="#">Приклад</a>
                    <div><a class="btn btn-black" href="#">Спробувати безкоштовно</a></div>
                </div>

                <div class="plan">
                    <h3>Автор</h3>
                    <p class="price">$32/місяць*</p>
                    <ul>
                        <li>Платний доступ і підписки</li>
                        <li>Розсилки</li>
                        <li>Шрифти, кольори, логотип</li>
                        <li>Коментарі та оцінки</li>
                        <li>Реклама й відео</li>
                        <li>Власний домен</li>
                    </ul>
                    <a class="example desc" href="#">Приклад</a>
                    <div><a class="btn btn-black" href="#">Обрати тариф</a></div>
                </div>

                <div class="plan">
                    <h3>Професійний</h3>
                    <p class="price">$250–500/місяць*</p>
                    <ul>
                        <li>Власний дизайн і сторінки</li>
                        <li>Власні функції</li>
                        <li>Персональна підтримка</li>
                    </ul>
                    <a class="example desc" href="#">Приклад</a>
                    <div><a class="btn btn-black" href="#">Зв'язатися з нами</a></div>
                </div>
            </div>

            <p class="note">*Додатково 6% від доходу з підписок і кулінарних книг, максимум $4 000 на місяць.</p>
        </section>

        @{
            Showcase("Ryan Nordheimer", "https://www.ryannordheimer.com/", new[] { "сайт", "реклама", "підписки" }, new[]
            {
                ('l', "marketing_homepage_ryannordheimer_01"), ('b', "marketing_homepage_ryannordheimer_02"),
                ('l', "marketing_homepage_ryannordheimer_03"), ('l', "marketing_homepage_ryannordheimer_04")
            });
        }

        @* ===== Чим відрізняємось ===== *@
        <section class="wrap block diff" id="about">
            <div class="two-col">
                <div>
                    <p class="lead">
                        Ми однаково уважні до <strong>рецептів</strong>, <strong>дизайну</strong> та
                        <strong>технологій</strong>. Тому наші сайти й кулінарні книги працюють краще.
                    </p>
                </div>

                <div class="aside">
                    <p>
                        На відміну від <em>конструкторів сайтів</em> (WordPress, Squarespace, Wix), ми створені саме для рецептів
                        і монетизації. Підписки, платний доступ і розсилки вже вбудовані, без плагінів.
                    </p>
                    <p>
                        На відміну від <em>контентних платформ</em> (Instagram, Substack), у вас не профіль у чужій мережі,
                        а власний сайт: ви контролюєте і контент, і аудиторію.
                    </p>
                    <p><a href="#">Читати в блозі</a></p>
                </div>
            </div>
        </section>

        @* ===== Підписка на новини ===== *@
        <section class="wrap block updates">
            <h2>Новини проєкту</h2>
            <p>Раз на кілька місяців розповідаємо про нові функції та плани.</p>
            <form class="subscribe" action="#" method="post">
                <input type="email" name="email" placeholder="Ваша пошта" aria-label="Електронна пошта" required />
                <button type="submit">Підписатися</button>
            </form>
        </section>
    </main>

    @* ===== Футер ===== *@
    <footer class="site-footer">
        <div class="wrap">
            <div>
                <p><a href="~/">Recipe.Site</a> — платформа для авторів кулінарного контенту</p>
                <p class="fine">Відгуки: alex@@recipe.site</p>
                <p>© 2026 Recipe.Site</p>
            </div>
            <nav class="footer-links" aria-label="Підвал сайту">
                <a href="#">Почати</a>
                <a href="#plans">Тарифи</a>
                <a href="#about">Про нас</a>
                <a href="/Blogs">Блог</a>
                <a href="#">Умови</a>
            </nav>
        </div>
    </footer>

    @* Стрілки каруселей: прокрутка на пів ширини, блокування на краях *@
    <script>
            (function () {
                document.querySelectorAll('.showcase').forEach(function (section) {
                    var track = section.querySelector('.carousel');
                    var prev = section.querySelector('[data-dir="prev"]');
                    var next = section.querySelector('[data-dir="next"]');
                    if (!track || !prev || !next) return;

                    function update() {
                        var max = track.scrollWidth - track.clientWidth;
                        prev.disabled = track.scrollLeft <= 1;
                        next.disabled = track.scrollLeft >= max - 2;
                    }

                    function go(dir) {
                        track.scrollBy({ left: dir * track.clientWidth * 0.5, behavior: 'smooth' });
                    }

                    prev.addEventListener('click', function () { go(-1); });
                    next.addEventListener('click', function () { go(1); });
                    track.addEventListener('scroll', update, { passive: true });
                    window.addEventListener('resize', update);
                    update();
                });
            })();
    </script>
</body>
</html>
